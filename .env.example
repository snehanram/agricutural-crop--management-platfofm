# Server port (AI Studio uses 3000)
PORT=3000

# JWT Secret for farmer session authentication
JWT_SECRET="replace-with-a-strong-random-secret"

# Application URL
APP_URL="http://localhost:3000"

# Optional: Gemini API Key if extending with AI capabilities
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Google OAuth 2.0 ("Login with Google")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Sign in with Apple ("Login with Apple / Mac")
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

